{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linuxdo-rss-cdn",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
